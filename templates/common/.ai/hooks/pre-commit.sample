#!/bin/sh
# ai-memory 就绪门禁的跨工具兜底:提交前检查进行中的需求点定稿是否齐备。
# 安装(显式动作,框架不会替你装):
#   ai-memory hooks install
# 或手工合并到 `git rev-parse --git-path hooks/pre-commit` 指出的有效 hook。
# Git hook 可能被多个 worktree 共用;Git 会在触发提交的工作区根目录运行本脚本。
#
# Claude Code 侧有 PreToolUse/Stop hook 在开工前与收尾时拦截;
# 其他工具(如 Codex)没有等价机制,本脚本是它们唯一的自动门禁。
# ai-memory 不可用时放行并在终端提示——门禁坏掉不应该让人无法提交,但也不能悄悄失效。
# CLI 的定位(项目内安装 / 全局安装 / AI_MEMORY_CLI)由 .ai/hooks/gate.mjs 负责。

GATE=".ai/hooks/gate.mjs"
if ! command -v node >/dev/null 2>&1 || [ ! -f "$GATE" ]; then
  echo "[ai-memory] 门禁未执行:缺少 node 或 $GATE" >&2
  exit 0
fi
if ! node "$GATE" --probe; then
  echo "[ai-memory] 门禁未执行:找不到 ai-memory CLI。安装后生效:npm i -g @betterdanlins/ai-memory" >&2
  exit 0
fi

node "$GATE" gate ready || exit 1
node "$GATE" gate contract --staged || exit 1
node "$GATE" kb check || exit 1
